{
  "name": "orka-api",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/protocol"
  ],
  "scripts": {
    "build": "npm run build:protocol && npm run contracts:go && npm run build:go",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/acceptance/integration.ts",
    "start:oss": "artifacts/bin/orka-server serve",
    "migrate": "artifacts/bin/orka-server migrate",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"*.{js,json,ts}\" .github packages tests scripts",
    "format:check": "prettier --check \"*.{js,json,ts}\" .github packages tests scripts",
    "deploy:check": "artifacts/bin/orka-server check-deployment",
    "package:release": "npm run build && node scripts/release/package-release.mjs",
    "check:repository": "tsx scripts/check-repository.ts",
    "test:images": "tsx tests/acceptance/image-e2e.ts",
    "test:self-hosted": "tsx tests/acceptance/self-hosted-e2e.ts",
    "licenses": "node scripts/dependency-licenses.mjs",
    "licenses:check": "node scripts/dependency-licenses.mjs --check && node scripts/go-licenses.mjs --check",
    "migrate:sources": "artifacts/bin/orka-server migrate-sources",
    "package:operator": "node scripts/release/package-operator.mjs",
    "build:protocol": "npm run build -w @portable/protocol",
    "contracts:go": "node scripts/generate-go-contracts.mjs",
    "contracts:check": "node scripts/generate-go-contracts.mjs --check && node scripts/generate-go-fixtures.mjs --check && node scripts/check-go-contracts.mjs",
    "build:go": "go build -trimpath -o artifacts/bin/orka-server ./cmd/orka-server && go build -tags orkatest -o artifacts/bin/orka-test-server ./cmd/orka-test-server",
    "test:go": "go test -race ./internal/... ./cmd/... ./packages/server-core/migrations/...",
    "licenses:go": "node scripts/go-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.18.0",
    "resend": "^6.32.1",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whysosaket/orka-api.git"
  },
  "license": "MIT"
}
