{
  "name": "orka-api",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @portable/protocol && npm run build -w @portable/server-core && tsc -p tsconfig.apps.json && node scripts/copy-deployment.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/integration.ts",
    "start:oss": "node artifacts/apps/oss/main.js",
    "start:managed": "node artifacts/apps/managed/main.js",
    "migrate": "node packages/server-core/dist/migrate.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"*.{js,json,ts}\" .github packages apps tests scripts",
    "format:check": "prettier --check \"*.{js,json,ts}\" .github packages apps tests scripts",
    "local:up": "ORKA_API_SOURCE=. node packages/server-core/dist/tools/local-dev.js up",
    "local:down": "node packages/server-core/dist/tools/local-dev.js down",
    "local:user": "node packages/server-core/dist/tools/local-dev.js user",
    "test:local": "node packages/server-core/dist/tools/check-local.js",
    "deploy:check": "node packages/server-core/dist/tools/check-deployment.js",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "check:repository": "tsx scripts/check-repository.ts",
    "test:images": "tsx scripts/image-e2e.ts",
    "test:self-hosted": "tsx scripts/self-hosted-e2e.ts",
    "licenses": "node scripts/dependency-licenses.mjs",
    "licenses:check": "node scripts/dependency-licenses.mjs --check",
    "migrate:sources": "node packages/server-core/dist/tools/migrate-project-sources.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whysosaket/orka-api.git"
  },
  "license": "MIT"
}
