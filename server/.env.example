# Optional direct API development; Docker setup uses its own generated .env.local.
# Replace placeholders locally. Never commit a populated environment file.
DATABASE_URL=postgresql://orka_api:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/orka
AUTH_URL=http://127.0.0.1:9999
BLOB_ROOT=.runtime/blobs
PORT=8080
MEMORY_JEV_ENABLED=true
JEV_API_KEY=
TYPESAFE_API_KEY=
# Production: deploy/ec2/.env.example. Local stack: npm run local:up.

# Direct self-hosted API with password sign-in:
PUBLIC_URL=http://127.0.0.1:8080
DEPLOYMENT_MODE=self-hosted
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional GitHub repository integration.
GITHUB_REPOS_ENABLED=false
GITHUB_REPOS_APP_SLUG=
GITHUB_REPOS_TOKEN_KEY=
GITHUB_REPOS_WEBHOOK_SECRET=

# Optional project invitation delivery; missing settings retain joining links.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
