# Run: sh configure.sh your.server.example
# Configure creates private .env credentials and never replaces an existing file.
DOMAIN=orka.example.com
# configure.sh fills these once. Compose and the helper reuse the saved selection.
ORKA_SERVER_MODE=public
ORKA_LOCAL_PORT=8080
COMPOSE_PROJECT_NAME=
COMPOSE_FILE=compose.yml
# Empty in source installations. Operator releases pin their supplied image.
ORKA_IMAGE=
POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
API_DB_PASSWORD=
JWT_SECRET=
ORKA_OPERATOR_UID=1000
ORKA_OPERATOR_GID=1000
# Optional GitHub repository connections. Self-hosted sign-in uses passwords.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REPOS_ENABLED=false
GITHUB_REPOS_APP_SLUG=
GITHUB_REPOS_TOKEN_KEY=
GITHUB_REPOS_WEBHOOK_SECRET=
# No external inference service is required to run the server. Memory replacements
# remain queued until JEV is configured; additions and uncontested deletions work.
MEMORY_JEV_ENABLED=false
JEV_API_KEY=
TYPESAFE_API_KEY=

# Optional project invitation delivery; missing settings retain joining links.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
