DOMAIN=orka.example.com
# For a stable public IP instead of DNS: DOMAIN=<IP>, CADDY_CONFIG=Caddyfile.ip
CADDY_CONFIG=Caddyfile
DATA_ROOT=/srv/orka
# Use separate random hex passwords so connection URLs need no percent escaping.
POSTGRES_PASSWORD=replace_with_random_hex
AUTH_DB_PASSWORD=replace_with_random_hex
API_DB_PASSWORD=replace_with_random_hex
JWT_SECRET=replace_with_at_least_32_random_bytes
# JEV judges memory replacements and conflicting edits in both deployments.
# Store the key only on the server. Missing/disabled JEV leaves those edits queued.
MEMORY_JEV_ENABLED=true
JEV_API_KEY=
# Compatibility alias, used only when JEV_API_KEY is blank.
TYPESAFE_API_KEY=
# The image fixes the deployment mode; cloud uses the managed Compose overlay.
DEPLOYMENT_MODE=self-hosted
PASSWORD_ENABLED=true
# Pin a released image version or digest.
ORKA_IMAGE=ghcr.io/whysosaket/orka-server:0.3.0
# Keep private servers invite-only; set false for public GitHub/magic-link registration.
DISABLE_SIGNUP=true
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Use the same GitHub App credentials above for sign-in and repositories.
GITHUB_REPOS_ENABLED=false
GITHUB_REPOS_APP_SLUG=
# Generate once: openssl rand -hex 32. Preserve in protected configuration backups.
GITHUB_REPOS_TOKEN_KEY=
GITHUB_REPOS_WEBHOOK_SECRET=
MAGIC_LINK_ENABLED=false
# To use Resend set both EMAIL_PROVIDER=resend and RESEND_ENABLED=true.
EMAIL_PROVIDER=smtp
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=
# Generate: printf 'v1,whsec_'; openssl rand -base64 32
SEND_EMAIL_HOOK_SECRET=
# Defaults to https://<DOMAIN>/auth/hooks/send-email; must be HTTPS in production.
# SEND_EMAIL_HOOK_URL=
# SMTP is an alternative for self-hosters. Password login needs neither provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Enable the read-only ChatGPT/Codex plugin after deploying and verifying /mcp.
MCP_ENABLED=false
